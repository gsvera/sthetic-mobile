{
  "expo": {
    "name": "Meredith Aesthetic Worker",
    "slug": "sthetic-mobile",
    "version": "1.0.16",
    "orientation": "default",
    "icon": "./assets/images/meredith-aesthetic-work-logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceder a tu ubicación para mostrar tu posición en el mapa.",
        "NSCameraUsageDescription": "Necesitamos acceso a tu cámara para que puedas tomar fotos y mostrarle a tus clientes quién eres, brindando mayor confianza en tus servicios.",
        "NSPhotoLibraryAddUsageDescription": "Necesitamos acceso a tu galería para que puedas seleccionar y subir fotos como evidencia de tus trabajos realizados."
      },
      "bundleIdentifier": "com.abasotech.meredithcarework",
      "config": {
        "usesNonExemptEncryption": false,
        "googleMapsApiKey": "AIzaSyBEPqhm55f6JnlZv_lIxiikGiUiuU7YJ4w"
      },
      "appleId": "gs.vera92@gmail.com",
      "ascAppId": "6754846887"
    },
    "android": {
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "supportsTablet": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/meredith-aesthetic-work-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abasotech.meredithcarework",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBEPqhm55f6JnlZv_lIxiikGiUiuU7YJ4w"
        }
      },
      "intentFilters": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/meredith-aesthetic-work-logo.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/meredith-aesthetic-work-logo.png"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/meredith-aesthetic-work-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "expoDebug": true,
      "router": {},
      "eas": {
        "projectId": "e3d35683-dbbb-4ebe-b105-7648e05b2546"
      }
    }
  }
